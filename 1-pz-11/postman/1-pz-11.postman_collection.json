                  "pm.test('detail про відсутність книги', () => pm.expect(pm.response.json().detail).to.include('не знайдено'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /books/999/borrow — не знайдено (404)",
          "request": {
